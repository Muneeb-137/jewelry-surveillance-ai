# VaultVision — production environment (copy to .env and set values)

# Dashboard branding (optional)
# JEWELGUARD_PRODUCT_NAME=VaultVision
# JEWELGUARD_PRODUCT_TAGLINE=Retail Surveillance System

# Optional store/location label (shown in status bar when set)
# JEWELGUARD_STORE_NAME=Downtown Branch

# Optional API key — required header X-API-Key for start/stop/dismiss/ack/resolve
# JEWELGUARD_API_KEY=change-me-in-production

# Webhook for incident alerts (Slack, Teams, PagerDuty, custom SIEM)
# JEWELGUARD_WEBHOOK_URL=https://hooks.example.com/jewelguard

# Minimum risk score to trigger webhook (default 40)
JEWELGUARD_NOTIFY_MIN_RISK=40

# Auto-delete incidents older than N days on startup (0 = keep forever)
JEWELGUARD_RETENTION_DAYS=90

# --- Source mode (pick one) ---
# JEWELGUARD_MODE=webcam
# JEWELGUARD_MODE=video
# JEWELGUARD_MODE=rtsp

# Video file (when mode=video)
# JEWELGUARD_VIDEO_PATH=C:\path\to\store_camera.mp4
# JEWELGUARD_VIDEO_PROFILE=near

# IP camera RTSP (when mode=rtsp)
# JEWELGUARD_RTSP_URL=rtsp://user:pass@192.168.1.50:554/stream1
# JEWELGUARD_VIDEO_PROFILE=near

# Frontend (create frontend/jewelguard-dashboard/.env.local)
# VITE_API_URL=http://127.0.0.1:8000
# VITE_API_KEY=change-me-in-production
